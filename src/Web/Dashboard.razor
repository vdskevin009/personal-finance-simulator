@inject BrowserStore Store
<div class="notice"><span class="badge">SCENARIO EXPLORER</span> Illustrative projections, not forecasts or personalized financial advice. Inputs are assumptions and stay on this device.</div>
@if(error!="") { <p role="alert" class="error">@error</p> }
@if(message!="") { <p role="status" class="success">@message</p> }
<div class="tabs"><button class="@(mode=="Compare" ? "active" : "")" @onclick='()=>mode="Compare"'>Mortgage vs investing</button><button class="@(mode=="Savings" ? "active" : "")" @onclick='()=>mode="Savings"'>Savings & growth</button></div>
<section class="stats">
@if(mode=="Compare") { <div class="stat"><small>MONTHLY MORTGAGE</small><strong>@Money(result.Payment)</strong><small>Principal + interest only</small></div><div class="stat"><small>INTEREST SAVED BY PREPAYING</small><strong>@Money(result.InvestInterest-result.PrepayInterest)</strong><small>Over @applied.Years years</small></div><div class="stat"><small>EARLY PAYOFF</small><strong>@(result.PayoffMonth/12)y @(result.PayoffMonth%12)m</strong><small>With @Money(applied.Extra) extra per month</small></div> }
else { <div class="stat"><small>PROJECTED SAVINGS</small><strong>@Money(Last.Savings)</strong><small>After @applied.Years years</small></div><div class="stat"><small>YOUR CONTRIBUTIONS</small><strong>@Money(Last.Contributions)</strong><small>Initial amount + monthly savings</small></div><div class="stat"><small>PROJECTED GROWTH</small><strong>@Money(Last.Savings-Last.Contributions)</strong><small>Before fees and taxes</small></div> }
</section>
<div class="grid"><div><section class="card"><div class="card-head"><h2>@(mode=="Compare" ? "Two paths, one budget" : "Let time do its part")</h2><span class="badge">@applied.Years YEARS</span></div><p class="muted">@(mode=="Compare" ? "Investment assets minus remaining mortgage debt. Property value is excluded equally from both paths." : "Starting capital grows at your assumed rate, with contributions at the end of every month.")</p>
<svg class="chart" viewBox="0 0 620 280" role="img" aria-label="@ChartLabel"><title>@ChartLabel</title>
@foreach(var y in new[]{30,90,150,210}){<line x1="55" y1="@y" x2="600" y2="@y" stroke="#e4e9df"/>}
<text x="8" y="32" font-size="10" fill="#798575">@Money(Max)</text><text x="8" y="213" font-size="10" fill="#798575">@Money(Min)</text>
<polyline points="@Points(false)" fill="none" stroke="#286777" stroke-width="3"/><polyline points="@Points(true)" fill="none" stroke="#ce9e52" stroke-width="3"/>
<text x="55" y="250" font-size="11" fill="#798575">Today</text><text x="540" y="250" font-size="11" fill="#798575">Year @applied.Years</text></svg>
<div class="legend"><span><i class="dot"></i>@(mode=="Compare" ? "Invest the extra" : "Projected balance")</span><span><i class="dot gold"></i>@(mode=="Compare" ? "Prepay, then invest" : "Contributions")</span></div>
@if(mode=="Compare") { <div class="row"><span>Invest the extra / final net position</span><strong>@Money(Last.InvestNet)</strong></div><div class="row"><span>Prepay, then invest / final net position</span><strong>@Money(Last.PrepayNet)</strong></div><p class="notice">Under these assumptions, the difference is @Money(Math.Abs(Last.InvestNet-Last.PrepayNet)) in favor of @(Last.InvestNet>=Last.PrepayNet ? "investing the extra" : "prepaying then investing"). Investment returns can vary or be negative.</p> }
else { <div class="row"><span>Final balance in today's money</span><strong>@Money(Last.Savings/Math.Pow(1+applied.Inflation/100,applied.Years))</strong></div> }
</section><section class="card"><div class="card-head"><h2>Year by year</h2><button class="secondary" @onclick="Export">Export CSV</button></div><div class="table-wrap"><table><thead><tr><th>Year</th><th>@(mode=="Compare"?"Invest net":"Balance")</th><th>@(mode=="Compare"?"Prepay net":"Contributed")</th></tr></thead><tbody>@foreach(var point in result.Points){<tr><td>@point.Year</td><td>@Money(mode=="Compare"?point.InvestNet:point.Savings)</td><td>@Money(mode=="Compare"?point.PrepayNet:point.Contributions)</td></tr>}</tbody></table></div></section></div>
<div><section class="card"><h2>Shape your scenario</h2><form @onsubmit="Calculate" @onsubmit:preventDefault><div class="form-grid">
@if(mode=="Compare") { <label>Mortgage balance<input type="number" @bind="principal" min="0" max="100000000" step="100" required/></label><label>Mortgage rate (%)<input type="number" @bind="mortgageRate" min="0" max="30" step="0.01" required/></label> }
<label>Horizon / term (years)<input type="number" @bind="years" min="1" max="50" required/></label><label>@(mode=="Compare"?"Extra monthly budget":"Monthly savings")<input type="number" @bind="extra" min="0" max="100000" step="1" required/></label>
<label>Initial investments<input type="number" @bind="initial" min="0" max="100000000" step="100" required/></label><label>Annual return (%)<input type="number" @bind="returnRate" min="-50" max="30" step="0.1" required/></label><label>Inflation (%)<input type="number" @bind="inflation" min="-10" max="30" step="0.1" required/></label><label>Display currency<select @bind="currency"><option>EUR</option><option>USD</option><option>GBP</option></select></label>
<button class="full" type="submit">Update projection →</button></div></form><p class="notice">Charts use the last applied inputs. Currency changes the display label only; no exchange conversion is performed.</p><button class="secondary" @onclick="Save">Save scenario on this device</button></section>
<section class="card tinted"><h2>Read the assumptions</h2><p class="muted">Fixed mortgage rate, monthly amortization, constant investment return, end-of-month contributions. Both strategies spend the same monthly amount. After payoff, freed payments are invested.</p><details><summary>Calculation details & exclusions</summary><p>Mortgage monthly rate = annual percentage / 1,200. Investment monthly growth = (1 + annual percentage / 100)^(1/12). Initial investments are identical in both strategies. The comparison excludes property value, taxes, fees, insurance, early-repayment penalties and changing rates.</p><p>The savings tab is a standalone investment projection; it ignores mortgage payments. Negative assumed returns are supported. Real-world returns fluctuate and are not guaranteed. Values are calculated at full precision and rounded only for display.</p></details></section></div></div>
@code {
double principal=250000,mortgageRate=3.5,extra=300,initial=10000,returnRate=5,inflation=2;int years=25;
string mode="Compare",currency="EUR",error="",message="";
Scenario applied=new(); Projection result=Finance.Calculate(new());
YearPoint Last=>result.Points[^1];
IEnumerable<double> Values=>result.Points.SelectMany(p=>mode=="Compare"?new[]{p.InvestNet,p.PrepayNet}:new[]{p.Savings,p.Contributions});
double Min=>Math.Min(0,Values.Min()); double Max=>Math.Max(1,Values.Max());
string ChartLabel=>mode=="Compare" ? $"Net position over {applied.Years} years. Invest {Money(Last.InvestNet)}, prepay {Money(Last.PrepayNet)}. Full values in the table below." : $"Savings projection over {applied.Years} years, ending at {Money(Last.Savings)}. Full values in the table below.";
string Points(bool second)=>string.Join(" ",result.Points.Select(p=>$"{(55+p.Year*545d/applied.Years).ToString("F2",CultureInfo.InvariantCulture)},{(210-180*((mode=="Compare"?(second?p.PrepayNet:p.InvestNet):(second?p.Contributions:p.Savings))-Min)/(Max-Min)).ToString("F2",CultureInfo.InvariantCulture)}"));
string Money(double value)=>$"{(currency=="EUR"?"€":currency=="GBP"?"£":"$")}{value.ToString("N0",CultureInfo.GetCultureInfo("en-GB"))}";
void Calculate(){try{var next=new Scenario(principal,mortgageRate,years,extra,initial,returnRate,inflation);var projection=Finance.Calculate(next);applied=next;result=projection;error="";message="";}catch(Exception ex){error=ex.Message;}}
protected override async Task OnInitializedAsync(){try{var saved=await Store.Load<Scenario>("finance.v1");if(saved is not null){Finance.Validate(saved);principal=saved.Principal;mortgageRate=saved.MortgageRate;years=saved.Years;extra=saved.Extra;initial=saved.Initial;returnRate=saved.ReturnRate;inflation=saved.Inflation;Calculate();}}catch{error="Saved scenario could not be read. Showing the default assumptions.";}}
async Task Save(){Calculate();if(error!="")return;try{await Store.Save("finance.v1",applied);message="Scenario saved on this device.";}catch{error="Browser storage is unavailable.";}}
Task Export(){var csv="year,invest_assets,prepay_assets,invest_debt,prepay_debt,invest_net,prepay_net,savings,contributions\n"+string.Join("\n",result.Points.Select(p=>string.Join(",",new[]{(double)p.Year,p.InvestAssets,p.PrepayAssets,p.InvestDebt,p.PrepayDebt,p.InvestNet,p.PrepayNet,p.Savings,p.Contributions}.Select(n=>n.ToString("F2",CultureInfo.InvariantCulture)))));return Store.Download("finance-projection.csv",csv,"text/csv");}
}
